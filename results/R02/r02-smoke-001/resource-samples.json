{
  "kind": "r02-resource-sampling",
  "labels": {
    "errors": "a sample with status 'error' carries no reading: value UNSET and a redacted error",
    "peak_claims": "filled in only from a device peak counter, and the basis names the window it covered",
    "sampled_max": "maximum over the sampled instants only; not a peak measurement",
    "scope": "GPU figures describe the shared GPU, RAM figures describe the execution target"
  },
  "method": {
    "clock": "system UTC clock, read once per sampling instant",
    "instant_count": 2,
    "instants": [
      "2026-09-21T03:10:09Z",
      "2026-09-21T03:11:19Z"
    ],
    "interval_seconds": "UNSET",
    "probes": [
      {
        "basis": "UNSET",
        "command": "nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits",
        "kind": "sample",
        "name": "nvidia-smi",
        "units": {
          "gpu_utilization_pct": "%",
          "vram_total_mib": "MiB",
          "vram_used_mib": "MiB"
        }
      },
      {
        "basis": "UNSET",
        "command": "/proc/meminfo (MemAvailable, MemTotal)",
        "kind": "sample",
        "name": "proc-meminfo",
        "units": {
          "ram_available_mib": "MiB",
          "ram_total_mib": "MiB"
        }
      },
      {
        "basis": "device peak counter, reset at run start before any load and read after the generation step: the window covers tokenizer load, model load and generation",
        "command": "torch.cuda.reset_peak_memory_stats() before any load, then max_memory_allocated() / max_memory_reserved() after the generation step",
        "kind": "peak-counter",
        "name": "torch.cuda peak counters",
        "units": {
          "vram_peak_allocated_mib": "MiB",
          "vram_peak_reserved_mib": "MiB"
        }
      }
    ]
  },
